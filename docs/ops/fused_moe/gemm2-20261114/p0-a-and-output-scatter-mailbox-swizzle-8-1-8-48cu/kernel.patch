+                        hcu.abarrier_seq(ready)
+                        hcu.matrix_load(dest.index(physical), b_base, (K, N), (1, K),
+                                        (k * BK, n * BN + half * (BN // 2)), warps=(2, 2))
+                        hcu.abarrier_arrive(ready)
+                epoch += 1
