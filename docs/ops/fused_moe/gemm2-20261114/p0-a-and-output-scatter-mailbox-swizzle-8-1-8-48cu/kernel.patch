+                if CK_SORTING:
+                    route = (route & 0x00ffffff) * TOP_K + ((route >> 24) & 255)
+                output_rows += (route.to(gl.uint32) * N,)
+                output_valid += ((route >= 0) & (route < valid_routes) & (expert >= 0),)
+            for n in range(0, N // BN):
