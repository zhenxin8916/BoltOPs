diff --git a/llvm/lib/Target/AMDGPU/SIInstrInfo.cpp b/llvm/lib/Target/AMDGPU/SIInstrInfo.cpp
index 7f518b4fa830..26e18c159fa6 100644
--- a/llvm/lib/Target/AMDGPU/SIInstrInfo.cpp
+++ b/llvm/lib/Target/AMDGPU/SIInstrInfo.cpp
@@ -9084,0 +9085,12 @@ bool SIInstrInfo::shouldSink(const MachineInstr &MI) const {
+  // HCU mailbox credits can release LDS storage to another wave. Although
+  // these barriers issue no memory request, sinking a preceding load past a
+  // barrier can race with the next producer overwrite. Keep loads in their
+  // original block when such a barrier follows; address arithmetic may sink.
+  // Do not model barriers as memory accesses: that adds cache operations.
+  if (MI.mayLoad()) {
+    for (auto I = std::next(MI.getIterator()), E = MI.getParent()->instr_end();
+         I != E; ++I) {
+      if (isLHBarrier(*I))
+        return false;
+    }
+  }
diff --git a/llvm/test/HCU/GFX946/CodeGen/abarrier-memory-order.ll b/llvm/test/HCU/GFX946/CodeGen/abarrier-memory-order.ll
new file mode 100644
index 000000000000..ee3cd8b5db55
--- /dev/null
+++ b/llvm/test/HCU/GFX946/CodeGen/abarrier-memory-order.ll
@@ -0,0 +1,29 @@
+; RUN: llc -march=amdgcn -mcpu=gfx946 -O3 -verify-machineinstrs < %s | FileCheck %s --implicit-check-not=buffer_wbinvl1
+;
+; A conditional mailbox store must not sink the LDS read past release of its
+; EMPTY credit. Another wave can overwrite that physical slot at release.
+; hasSideEffects alone on the abarrier instruction does not protect the load
+; in MachineSink: target sinking legality must preserve this ordering.
+;
+; CHECK-LABEL: release_credit:
+; CHECK: ds_read_b32
+; CHECK: s_abarrier_arrive
+; CHECK: s_cbranch
+; CHECK-NOT: ds_read
+; CHECK: s_endpgm
+
+target triple = "amdgcn-amd-amdhsa"
+
+define amdgpu_kernel void @release_credit(ptr addrspace(3) %shared, ptr addrspace(1) %out, i1 %write) {
+entry:
+  %value = load i32, ptr addrspace(3) %shared, align 4
+  %credit = call i32 (i32, ...) @llvm.hcu.s.abarrier.arrive(i32 11, i32 1)
+  br i1 %write, label %store, label %exit
+store:
+  store i32 %value, ptr addrspace(1) %out, align 4
+  br label %exit
+exit:
+  ret void
+}
+
+declare i32 @llvm.hcu.s.abarrier.arrive(i32, ...)
